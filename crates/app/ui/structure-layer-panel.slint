// Layer list panel — real model, per-row actions, TouchArea before buttons.

import { ScrollView } from "std-widgets.slint";
import { SquareButton } from "./components.slint";
import { StructureLayerRow } from "./structure-types.slint";

export component StructureLayerPanel inherits Rectangle {
    in property <[StructureLayerRow]> model: [];
    in property <string> selected-layer-id: "";

    callback select-layer(string);
    callback toggle-layer(string);
    callback delete-layer(string);
    callback raise-layer(string);
    callback lower-layer(string);

    background: #1a1a1e;
    border-width: 1px;
    border-color: #27272a;

    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 32px;
            background: #202124;
            border-width: 1px;
            border-color: #3a3c42;
            Text {
                x: 10px;
                text: "Layers";
                color: #e4e4e7;
                font-size: 11px;
                font-weight: 600;
                vertical-alignment: center;
                height: parent.height;
            }
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 6px;
                spacing: 2px;
                for layer in root.model: Rectangle {
                    height: 34px;
                    background: layer.selected ? #2a2a2e : transparent;
                    border-width: 1px;
                    border-color: layer.selected ? #6366f1 : #27272a;

                    TouchArea { clicked => { root.select-layer(layer.id); } }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 6px;
                        spacing: 6px;
                        Text {
                            text: layer.name;
                            color: #ffffff;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: layer.visible ? "[on]" : "[off]";
                            color: layer.visible ? #86efac : #f87171;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                        SquareButton { label: "Up"; width: 44px; height: 24px; clicked => { root.raise-layer(layer.id); } }
                        SquareButton { label: "Dn"; width: 44px; height: 24px; clicked => { root.lower-layer(layer.id); } }
                        SquareButton { label: "Vis"; width: 44px; height: 24px; clicked => { root.toggle-layer(layer.id); } }
                        SquareButton { label: "Del"; width: 44px; height: 24px; clicked => { root.delete-layer(layer.id); } }
                    }
                }
            }
        }
    }
}
