// Shared M5 structs — single source of truth for Structure UI types

export struct StructureVideoRow {
    id: string,
    title: string,
    duration: string,
    moments: string,
    status: string,
    selected: bool,
}

export struct StructureLayerRow {
    id: string,
    name: string,
    layer-type: string,
    visible: bool,
    selected: bool,
    x: float,
    y: float,
    width: float,
    height: float,
}

export struct CanvasLayer {
    id: string,
    layer-type: string,
    x: float,
    y: float,
    width: float,
    height: float,
    visible: bool,
    selected: bool,
    preview-image: image,
    preview-available: bool,
    asset-name: string,
    asset-valid: bool,
}

export struct MomentRow {
    index: int,
    start: string,
    end: string,
    duration: string,
    category: string,
    selected: bool,
    export-status: string,
}

export struct StructureAssetRow {
    id: string,
    name: string,
    kind: string,
    size: string,
    status: string,
    used-count: int,
}

export struct StructureLogRow {
    id: int,
    timestamp: string,
    level: string,
    scope: string,
    message: string,
    detail: string,
}
