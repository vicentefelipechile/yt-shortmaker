// Canvas layer item with selection, movement and resize handles.
// TouchArea.moved() has no args: deltas come from mouse-x/mouse-y tracking.
// Left button moves/selects. Middle button and Space+drag pan instead and are
// forwarded so the canvas can move the viewport without fighting the layer.

import { CanvasLayer } from "./structure-types.slint";

export component ResizeHandle inherits Rectangle {
    in property <string> handle: "bottom-right";
    in property <float> zoom: 0.3;
    in property <bool> space-held: false;

    callback handle-dragged(float, float);
    callback resize-started();
    callback resize-ended();
    callback pan-started();
    callback pan-moved(float, float);
    callback pan-ended();

    property <float> last-dx: 0;
    property <float> last-dy: 0;
    property <bool> pan-active: false;
    property <float> pan-last-x: 0;
    property <float> pan-last-y: 0;

    function track-pointer() {
        root.pan-last-x = drag.mouse-x / 1px;
        root.pan-last-y = drag.mouse-y / 1px;
    }

    width: 12px;
    height: 12px;
    background: #6366f1;
    border-width: 1px;
    border-color: #ffffff;

    drag := TouchArea {
        mouse-cursor: MouseCursor.nwse-resize;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                if (event.button == PointerEventButton.middle || (event.button == PointerEventButton.left && root.space-held)) {
                    root.pan-active = true;
                    root.track-pointer();
                    root.pan-started();
                } else if (event.button == PointerEventButton.left && !root.space-held) {
                    root.resize-started();
                }
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                if (root.pan-active) {
                    root.pan-active = false;
                    root.pan-ended();
                }
            }
        }
        changed pressed => {
            if (!self.pressed) {
                root.last-dx = 0;
                root.last-dy = 0;
                if (root.pan-active) {
                    root.pan-active = false;
                    root.pan-ended();
                } else {
                    root.resize-ended();
                }
            }
        }
        moved => {
            if (root.pan-active) {
                root.pan-moved(self.mouse-x / 1px - root.pan-last-x, self.mouse-y / 1px - root.pan-last-y);
                root.track-pointer();
            } else if (self.pressed && !root.space-held) {
                // Incremental to keep Rust additive correct
                root.handle-dragged(
                    (self.mouse-x - self.pressed-x) / root.zoom / 1px - root.last-dx,
                    (self.mouse-y - self.pressed-y) / root.zoom / 1px - root.last-dy
                );
                root.last-dx = (self.mouse-x - self.pressed-x) / root.zoom / 1px;
                root.last-dy = (self.mouse-y - self.pressed-y) / root.zoom / 1px;
            }
        }
    }
}

export component CanvasLayerItem inherits Rectangle {
    in property <string> layer-id;
    in property <string> layer-type: "clip";
    in property <float> layer-x;
    in property <float> layer-y;
    in property <float> layer-width;
    in property <float> layer-height;
    in property <bool> selected;
    in property <bool> layer-visible: true;
    in property <float> zoom: 0.3;
    in property <image> preview-image;
    in property <bool> preview-available: false;
    in property <string> asset-name: "";
    in property <bool> asset-valid: true;
    in property <bool> space-held: false;

    callback selected-layer();
    callback drag-started(string);
    callback dragged(float, float);
    callback drag-ended(string);
    callback resize-started(string);
    callback handle-dragged(string, float, float);
    callback resize-ended(string);
    callback pan-started();
    callback pan-moved(float, float);
    callback pan-ended();
    callback wheel-zoom-in();
    callback wheel-zoom-out();

    property <float> last-dx: 0;
    property <float> last-dy: 0;
    property <bool> pan-active: false;
    property <float> pan-last-x: 0;
    property <float> pan-last-y: 0;

    function track-pointer() {
        root.pan-last-x = move-area.mouse-x / 1px;
        root.pan-last-y = move-area.mouse-y / 1px;
    }

    x: layer-x * root.zoom * 1px;
    y: layer-y * root.zoom * 1px;
    width: layer-width * root.zoom * 1px;
    height: layer-height * root.zoom * 1px;
    visible: root.layer-visible;
    background: layer-type == "shader" ? #2a2a2e : #252629;
    border-width: 1px;
    border-color: root.selected ? #6366f1 : #3a3c42;
    clip: true;

    if root.preview-available: Image {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        source: root.preview-image;
        image-fit: contain;
        opacity: 0.9;
    }
    Text {
        x: 4px;
        y: 4px;
        text: root.layer-type + (root.asset-name == "" ? "" : "  " + root.asset-name);
        color: #a1a1aa;
        font-size: 9px;
    }
    if !root.asset-valid: Text {
        x: 4px;
        y: parent.height - 16px;
        text: "Asset unavailable";
        color: #f87171;
        font-size: 9px;
    }

    move-area := TouchArea {
        mouse-cursor: root.space-held ? MouseCursor.grab : MouseCursor.move;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                if (event.button == PointerEventButton.middle || (event.button == PointerEventButton.left && root.space-held)) {
                    root.pan-active = true;
                    root.track-pointer();
                    root.pan-started();
                } else if (event.button == PointerEventButton.left && !root.space-held) {
                    root.drag-started(root.layer-id);
                }
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                if (root.pan-active) {
                    root.pan-active = false;
                    root.pan-ended();
                }
            }
        }
        scroll-event(event) => {
            if (event.modifiers.control) {
                if (event.delta-y > 0px) {
                    root.wheel-zoom-in();
                } else if (event.delta-y < 0px) {
                    root.wheel-zoom-out();
                }
                return EventResult.accept;
            }
            return EventResult.reject;
        }
        clicked => {
            if (!root.space-held && !root.pan-active) {
                root.selected-layer();
            }
        }
        changed pressed => {
            if (!self.pressed) {
                root.last-dx = 0;
                root.last-dy = 0;
                if (root.pan-active) {
                    root.pan-active = false;
                    root.pan-ended();
                } else {
                    root.drag-ended(root.layer-id);
                }
            }
        }
        moved => {
            if (root.pan-active || (self.pressed && root.space-held)) {
                root.pan-moved(self.mouse-x / 1px - root.pan-last-x, self.mouse-y / 1px - root.pan-last-y);
                root.track-pointer();
            } else if (self.pressed && !root.space-held) {
                root.dragged(
                    (self.mouse-x - self.pressed-x) / root.zoom / 1px - root.last-dx,
                    (self.mouse-y - self.pressed-y) / root.zoom / 1px - root.last-dy
                );
                root.last-dx = (self.mouse-x - self.pressed-x) / root.zoom / 1px;
                root.last-dy = (self.mouse-y - self.pressed-y) / root.zoom / 1px;
            }
        }
    }

    if root.selected: ResizeHandle {
        handle: "top-left";
        zoom: root.zoom;
        space-held: root.space-held;
        x: 0px;
        y: 0px;
        resize-started => { root.resize-started(root.layer-id); }
        handle-dragged(dx, dy) => { root.handle-dragged("top-left", dx, dy); }
        resize-ended => { root.resize-ended(root.layer-id); }
        pan-started => { root.pan-started(); }
        pan-moved(dx, dy) => { root.pan-moved(dx, dy); }
        pan-ended => { root.pan-ended(); }
    }
    if root.selected: ResizeHandle {
        handle: "top-right";
        zoom: root.zoom;
        space-held: root.space-held;
        x: parent.width - 12px;
        y: 0px;
        resize-started => { root.resize-started(root.layer-id); }
        handle-dragged(dx, dy) => { root.handle-dragged("top-right", dx, dy); }
        resize-ended => { root.resize-ended(root.layer-id); }
        pan-started => { root.pan-started(); }
        pan-moved(dx, dy) => { root.pan-moved(dx, dy); }
        pan-ended => { root.pan-ended(); }
    }
    if root.selected: ResizeHandle {
        handle: "bottom-left";
        zoom: root.zoom;
        space-held: root.space-held;
        x: 0px;
        y: parent.height - 12px;
        resize-started => { root.resize-started(root.layer-id); }
        handle-dragged(dx, dy) => { root.handle-dragged("bottom-left", dx, dy); }
        resize-ended => { root.resize-ended(root.layer-id); }
        pan-started => { root.pan-started(); }
        pan-moved(dx, dy) => { root.pan-moved(dx, dy); }
        pan-ended => { root.pan-ended(); }
    }
    if root.selected: ResizeHandle {
        handle: "bottom-right";
        zoom: root.zoom;
        space-held: root.space-held;
        x: parent.width - 12px;
        y: parent.height - 12px;
        resize-started => { root.resize-started(root.layer-id); }
        handle-dragged(dx, dy) => { root.handle-dragged("bottom-right", dx, dy); }
        resize-ended => { root.resize-ended(root.layer-id); }
        pan-started => { root.pan-started(); }
        pan-moved(dx, dy) => { root.pan-moved(dx, dy); }
        pan-ended => { root.pan-ended(); }
    }

    if root.selected: Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        border-width: 1px;
        border-color: #6366f1;
        background: transparent;
    }
}
