// Canvas layer item with selection, movement and resize handles.
// TouchArea.moved() has no args: deltas come from mouse-x/pressed-x.
// Left button moves/selects. Middle button and Space+drag are rejected so the
// background pan area underneath can handle them.

import { CanvasLayer } from "./structure-types.slint";

export component ResizeHandle inherits Rectangle {
    in property <string> handle: "bottom-right";
    in property <float> zoom: 0.3;

    callback handle-dragged(float, float);
    callback resize-started();
    callback resize-ended();

    property <float> last-dx: 0;
    property <float> last-dy: 0;

    width: 12px;
    height: 12px;
    background: #6366f1;
    border-width: 1px;
    border-color: #ffffff;

    drag := TouchArea {
        mouse-cursor: MouseCursor.nwse-resize;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.resize-started();
            }
        }
        changed pressed => {
            if (!self.pressed) {
                root.last-dx = 0;
                root.last-dy = 0;
                root.resize-ended();
            }
        }
        moved => {
            if (self.pressed) {
                // Incremental to keep Rust additive correct
                root.handle-dragged(
                    (self.mouse-x - self.pressed-x) / root.zoom / 1px - root.last-dx,
                    (self.mouse-y - self.pressed-y) / root.zoom / 1px - root.last-dy
                );
                root.last-dx = (self.mouse-x - self.pressed-x) / root.zoom / 1px;
                root.last-dy = (self.mouse-y - self.pressed-y) / root.zoom / 1px;
            }
        }
    }
}

export component CanvasLayerItem inherits Rectangle {
    in property <string> layer-id;
    in property <string> layer-type: "clip";
    in property <float> layer-x;
    in property <float> layer-y;
    in property <float> layer-width;
    in property <float> layer-height;
    in property <bool> selected;
    in property <bool> layer-visible: true;
    in property <float> zoom: 0.3;
    in property <image> preview-image;
    in property <bool> preview-available: false;
    in property <string> asset-name: "";
    in property <bool> asset-valid: true;
    in property <bool> space-held: false;

    callback selected-layer();
    callback drag-started(string);
    callback dragged(float, float);
    callback drag-ended(string);
    callback resize-started(string);
    callback handle-dragged(string, float, float);
    callback resize-ended(string);
    callback wheel-zoom-in();
    callback wheel-zoom-out();

    property <float> last-dx: 0;
    property <float> last-dy: 0;

    x: layer-x * root.zoom * 1px;
    y: layer-y * root.zoom * 1px;
    width: layer-width * root.zoom * 1px;
    height: layer-height * root.zoom * 1px;
    visible: root.layer-visible;
    background: layer-type == "shader" ? #2a2a2e : #252629;
    border-width: 1px;
    border-color: root.selected ? #6366f1 : #3a3c42;
    clip: true;

    if root.preview-available: Image {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        source: root.preview-image;
        image-fit: contain;
        opacity: 0.9;
    }
    Text {
        x: 4px;
        y: 4px;
        text: root.layer-type + (root.asset-name == "" ? "" : "  " + root.asset-name);
        color: #a1a1aa;
        font-size: 9px;
    }
    if !root.asset-valid: Text {
        x: 4px;
        y: parent.height - 16px;
        text: "Asset unavailable";
        color: #f87171;
        font-size: 9px;
    }

    move-area := TouchArea {
        mouse-cursor: MouseCursor.move;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                if (!root.space-held) {
                    root.drag-started(root.layer-id);
                }
            }
        }
        scroll-event(event) => {
            if (event.modifiers.control) {
                if (event.delta-y > 0px) {
                    root.wheel-zoom-in();
                } else if (event.delta-y < 0px) {
                    root.wheel-zoom-out();
                }
                return EventResult.accept;
            }
            return EventResult.reject;
        }
        clicked => {
            if (!root.space-held) {
                root.selected-layer();
            }
        }
        changed pressed => {
            if (!self.pressed) {
                root.last-dx = 0;
                root.last-dy = 0;
                root.drag-ended(root.layer-id);
            }
        }
        moved => {
            if (self.pressed && !root.space-held) {
                root.dragged(
                    (self.mouse-x - self.pressed-x) / root.zoom / 1px - root.last-dx,
                    (self.mouse-y - self.pressed-y) / root.zoom / 1px - root.last-dy
                );
                root.last-dx = (self.mouse-x - self.pressed-x) / root.zoom / 1px;
                root.last-dy = (self.mouse-y - self.pressed-y) / root.zoom / 1px;
            }
        }
    }

    if root.selected: ResizeHandle {
        handle: "top-left";
        zoom: root.zoom;
        x: 0px;
        y: 0px;
        resize-started => { root.resize-started(root.layer-id); }
        handle-dragged(dx, dy) => { root.handle-dragged("top-left", dx, dy); }
        resize-ended => { root.resize-ended(root.layer-id); }
    }
    if root.selected: ResizeHandle {
        handle: "top-right";
        zoom: root.zoom;
        x: parent.width - 12px;
        y: 0px;
        resize-started => { root.resize-started(root.layer-id); }
        handle-dragged(dx, dy) => { root.handle-dragged("top-right", dx, dy); }
        resize-ended => { root.resize-ended(root.layer-id); }
    }
    if root.selected: ResizeHandle {
        handle: "bottom-left";
        zoom: root.zoom;
        x: 0px;
        y: parent.height - 12px;
        resize-started => { root.resize-started(root.layer-id); }
        handle-dragged(dx, dy) => { root.handle-dragged("bottom-left", dx, dy); }
        resize-ended => { root.resize-ended(root.layer-id); }
    }
    if root.selected: ResizeHandle {
        handle: "bottom-right";
        zoom: root.zoom;
        x: parent.width - 12px;
        y: parent.height - 12px;
        resize-started => { root.resize-started(root.layer-id); }
        handle-dragged(dx, dy) => { root.handle-dragged("bottom-right", dx, dy); }
        resize-ended => { root.resize-ended(root.layer-id); }
    }

    if root.selected: Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        border-width: 1px;
        border-color: #6366f1;
        background: transparent;
    }
}
