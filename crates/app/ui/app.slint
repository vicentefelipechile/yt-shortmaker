import { LineEdit, ScrollView } from "std-widgets.slint";

// ─── Design tokens ───
struct Tokens {
    bg: color,
    panel: color,
    card: color,
    input: color,
    border: color,
    border-strong: color,
    primary: color,
    primary-hover: color,
    text: color,
    text-dim: color,
    text-faint: color,
    success: color,
    danger: color,
}

// ─── Components ───

component NavButton inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked;
    height: 38px;
    border-radius: 8px;
    background: active ? #6366f1 : transparent;
    border-width: 1px;
    border-color: active ? #6366f1 : transparent;

    states [
        hover when touch.has-hover : {
            background: active ? #6366f1 : #27272a;
        }
        pressed when touch.pressed : {
            background: active ? #4f46e5 : #3f3f46;
        }
    ]

    touch := TouchArea { clicked => { root.clicked(); } }

    Text {
        text: root.label;
        color: active ? #ffffff : #a1a1aa;
        font-size: 13px;
        font-weight: active ? 600 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if active: Rectangle {
        width: 3px;
        height: 20px;
        x: 0px;
        y: (parent.height - self.height) / 2;
        background: #ffffff;
        border-radius: 0px;
    }
}

component PrimaryButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked;
    height: 36px;
    border-radius: 8px;
    background: #6366f1;

    states [
        hover when touch.has-hover : { background: enabled ? #5457e5 : #27272a; }
        pressed when touch.pressed : { background: enabled ? #4f46e5 : #27272a; }
        disabled when !enabled : { background: #27272a; }
    ]

    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }

    Text {
        text: root.label;
        color: enabled ? #ffffff : #71717a;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component GhostButton inherits Rectangle {
    in property <string> label;
    callback clicked;
    height: 36px;
    border-radius: 8px;
    background: #27272a;
    border-width: 1px;
    border-color: #3f3f46;

    states [
        hover when touch.has-hover : { background: #3f3f46; border-color: #52525b; }
        pressed when touch.pressed : { background: #27272a; }
    ]

    touch := TouchArea { clicked => { root.clicked(); } }

    Text {
        text: root.label;
        color: #e4e4e7;
        font-size: 13px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component Card inherits Rectangle {
    background: #1e1e22;
    border-width: 1px;
    border-color: #2d2d37;
    border-radius: 12px;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000040;
    clip: true;
}

component SectionHeader inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: 4px;
    Text {
        text: root.title;
        color: #ffffff;
        font-size: 22px;
        font-weight: 700;
    }
    if subtitle != "": Text {
        text: root.subtitle;
        color: #a1a1aa;
        font-size: 13px;
        wrap: word-wrap;
    }
}

export component MainWindow inherits Window {
    title: "yt-shortmaker v2";
    preferred-width: 1160px;
    preferred-height: 740px;
    min-width: 1020px;
    min-height: 640px;
    background: #0f0f12;

    in-out property <string> route: "home";
    in-out property <string> url-input: "";
    in-out property <string> url-error: "";
    in-out property <string> video-title: "";
    in-out property <float> progress: 0.0;
    in-out property <string> status-msg: "";
    in-out property <string> core-version: "2.0.0";

    in property <string> tr-navigate: "Navigate";
    in property <string> tr-home: "Home";
    in property <string> tr-new-project: "New Project";
    in property <string> tr-export-standalone: "Export Standalone";
    in property <string> tr-settings: "Settings";
    in property <string> tr-keys: "Keys";
    in property <string> tr-home-recent: "Recent projects";
    in property <string> tr-home-empty: "No projects yet. Create a new project to start.";
    in property <string> tr-new-project-title: "New Project";
    in property <string> tr-url-label: "Paste YouTube URL";
    in property <string> tr-fetch: "Fetch Info";
    in property <string> tr-export-title: "Export Standalone";
    in property <string> tr-export-desc: "Select clips and a plano to export without AI.";
    in property <string> tr-keys-title: "API Keys";

    callback navigate(string);
    callback fetch-info();
    callback start-analyze();
    callback add-moment();
    callback save-settings();

    HorizontalLayout {
        spacing: 0px;
        padding: 0px;

        // ── Sidebar ──
        Rectangle {
            width: 240px;
            background: #18181b;
            border-width: 1px;
            border-color: #27272a;

            VerticalLayout {
                padding: 20px;
                spacing: 16px;
                alignment: start;

                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: "yt-shortmaker";
                        color: #ffffff;
                        font-size: 16px;
                        font-weight: 700;
                    }
                    Text {
                        text: "v2  •  core " + root.core-version;
                        color: #71717a;
                        font-size: 11px;
                        font-weight: 500;
                    }
                }

                Rectangle { height: 1px; background: #27272a; }

                VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: root.tr-navigate;
                        color: #71717a;
                        font-size: 11px;
                        font-weight: 600;
                        letter-spacing: 0.8px;
                    }

                    NavButton { label: root.tr-home; active: route == "home"; clicked => { root.navigate("home"); } }
                    NavButton { label: root.tr-new-project; active: route == "new-project"; clicked => { root.navigate("new-project"); } }
                    NavButton { label: root.tr-export-standalone; active: route == "export"; clicked => { root.navigate("export"); } }
                    NavButton { label: root.tr-settings; active: route == "settings"; clicked => { root.navigate("settings"); } }
                    NavButton { label: root.tr-keys; active: route == "keys"; clicked => { root.navigate("keys"); } }
                }

                Rectangle { height: 1px; background: #27272a; }

                Text {
                    text: "Dark theme only • Slint native";
                    color: #52525b;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }
        }

        // ── Main ──
        Rectangle {
            background: #0f0f12;

            ScrollView {

                VerticalLayout {
                    padding: 32px;
                    spacing: 20px;
                    alignment: start;

                    // Home
                    if route == "home": VerticalLayout {
                        spacing: 20px;
                        SectionHeader {
                            title: root.tr-home-recent;
                            subtitle: "";
                        }

                        Card {
                            height: 220px;
                            VerticalLayout {
                                padding: 28px;
                                spacing: 16px;
                                alignment: center;
                                Text {
                                    text: "◈";
                                    color: #6366f1;
                                    font-size: 32px;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: root.tr-home-empty;
                                    color: #a1a1aa;
                                    font-size: 13px;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                                PrimaryButton {
                                    label: root.tr-new-project;
                                    width: 180px;
                                    clicked => { root.navigate("new-project"); }
                                }
                            }
                        }

                        Text {
                            text: "Tip: Paste a YouTube URL in New Project to generate shorts with AI.";
                            color: #71717a;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }

                    // New Project
                    if route == "new-project": VerticalLayout {
                        spacing: 20px;
                        SectionHeader {
                            title: root.tr-new-project-title;
                            subtitle: "Paste a URL, fetch info and run AI analysis.";
                        }

                        Card {
                            VerticalLayout {
                                padding: 20px;
                                spacing: 14px;
                                Text { text: root.tr-url-label; color: #e4e4e7; font-size: 13px; font-weight: 600; }

                                HorizontalLayout {
                                    spacing: 10px;
                                    Rectangle {
                                        background: #1f1f23;
                                        border-width: 1px;
                                        border-color: url-error != "" ? #ef4444 : #2d2d37;
                                        border-radius: 8px;
                                        height: 40px;
                                        horizontal-stretch: 1;

                                        HorizontalLayout {
                                            padding-left: 12px;
                                            padding-right: 12px;
                                            spacing: 8px;
                                            Text { text: "▶"; color: #71717a; font-size: 12px; vertical-alignment: center; }
                                            url-input-field := LineEdit {
                                                placeholder-text: "https://youtube.com/watch?v=...";
                                                text <=> root.url-input;
                                                horizontal-stretch: 1;
                                                font-size: 13px;
                                            }
                                        }
                                    }
                                    PrimaryButton { label: root.tr-fetch; width: 130px; clicked => { root.fetch-info(); } }
                                }

                                if url-error != "": Text { text: url-error; color: #ef4444; font-size: 12px; wrap: word-wrap; }
                                if video-title != "": Rectangle {
                                    background: #1a2e1a;
                                    border-radius: 8px;
                                    height: 36px;
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        spacing: 8px;
                                        Text { text: "✓"; color: #22c55e; font-size: 14px; vertical-alignment: center; }
                                        Text { text: video-title; color: #86efac; font-size: 13px; vertical-alignment: center; }
                                    }
                                }
                            }
                        }

                        Card {
                            VerticalLayout {
                                padding: 20px;
                                spacing: 12px;
                                HorizontalLayout {
                                    spacing: 10px;
                                    PrimaryButton { label: "Start Analyze"; width: 150px; clicked => { root.start-analyze(); } }
                                    GhostButton { label: "Add moment"; width: 130px; clicked => { root.add-moment(); } }
                                    Text { text: status-msg; color: #a1a1aa; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
                                }
                                // progress
                                Rectangle {
                                    height: 6px;
                                    background: #27272a;
                                    border-radius: 3px;
                                    Rectangle {
                                        width: parent.width * progress;
                                        height: 6px;
                                        background: #6366f1;
                                        border-radius: 3px;
                                        animate width { duration: 250ms; easing: ease-out; }
                                    }
                                }
                                Text {
                                    text: progress > 0 ? (progress * 100) + "%" : "";
                                    color: #71717a;
                                    font-size: 11px;
                                    horizontal-alignment: right;
                                }
                            }
                        }
                    }

                    // Export
                    if route == "export": VerticalLayout {
                        spacing: 20px;
                        SectionHeader {
                            title: root.tr-export-title;
                            subtitle: root.tr-export-desc;
                        }
                        Card {
                            height: 200px;
                            VerticalLayout {
                                padding: 24px;
                                spacing: 12px;
                                alignment: center;
                                Text { text: "⬢"; color: #6366f1; font-size: 28px; horizontal-alignment: center; }
                                Text { text: "No clips queued"; color: #e4e4e7; font-size: 14px; font-weight: 600; horizontal-alignment: center; }
                                Text { text: root.tr-export-desc; color: #71717a; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
                            }
                        }
                    }

                    // Settings
                    if route == "settings": VerticalLayout {
                        spacing: 20px;
                        SectionHeader { title: root.tr-settings; subtitle: "Preferences are saved to yt-shortmaker-v2/settings.json"; }
                        Card {
                            VerticalLayout {
                                padding: 20px;
                                spacing: 14px;
                                HorizontalLayout {
                                    spacing: 12px;
                                    Text { text: "Theme"; color: #e4e4e7; font-size: 13px; width: 120px; vertical-alignment: center; }
                                    Rectangle {
                                        background: #27272a;
                                        border-radius: 8px;
                                        height: 32px;
                                        width: 160px;
                                        Text { text: "Dark only"; color: #a1a1aa; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 12px;
                                    alignment: end;
                                    PrimaryButton { label: root.tr-settings; width: 120px; clicked => { root.save-settings(); } }
                                    Text { text: status-msg; color: #22c55e; font-size: 12px; vertical-alignment: center; }
                                }
                            }
                        }
                    }

                    // Keys
                    if route == "keys": VerticalLayout {
                        spacing: 20px;
                        SectionHeader { title: root.tr-keys-title; subtitle: "Manage Gemini API keys stored in OS keyring"; }
                        Card {
                            VerticalLayout {
                                padding: 20px;
                                spacing: 10px;
                                Rectangle {
                                    background: #1f1f23;
                                    border-radius: 8px;
                                    height: 40px;
                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        spacing: 8px;
                                        Text { text: "●"; color: #22c55e; font-size: 10px; vertical-alignment: center; }
                                        Text { text: "Active provider: gemini"; color: #e4e4e7; font-size: 13px; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text { text: "No keys configured."; color: #a1a1aa; font-size: 12px; vertical-alignment: center; }
                                    }
                                }
                                Text { text: status-msg; color: #71717a; font-size: 12px; }
                            }
                        }
                    }
                }
            }
        }
    }
}
