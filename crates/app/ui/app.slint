import { ScrollView } from "std-widgets.slint";
import { ModelDrawer } from "./model-drawer.slint";
import { StructureEditor } from "./structure-editor.slint";
import { CanvasLayer, MomentRow, StructureLayerRow, StructureVideoRow } from "./structure-types.slint";
import { NavItem, SquareButton, SquareChoice, SquareInput, SquareToggle } from "./components.slint";


struct KeyRow {
    name: string,
    enabled: bool,
    index: int,
}

struct ModelRow {
    id: string,
    display_name: string,
    model_id: string,
    base: string,
    enabled: bool,
    active: bool,
}

// =========================================================================================================
// Main Window
// =========================================================================================================

export component MainWindow inherits Window {
    title: "yt-shortmaker v2";
    preferred-width: 980px;
    preferred-height: 640px;
    min-width: 880px;
    min-height: 560px;
    background: #121214;

    in-out property <string> route: "home";
    in-out property <string> url-input: "";
    in-out property <string> url-error: "";
    in-out property <string> video-title: "";
    in-out property <string> video-id: "";
    in-out property <string> video-duration: "";
    in-out property <string> video-thumbnail: "";
    in property <image> video-thumbnail-image;
    in property <bool> video-has-info: false;
    in-out property <float> progress: 0.0;
    in-out property <string> status-msg: "";
    in-out property <string> core-version: "2.0.0";
    in-out property <string> output-dir: "";
    in-out property <string> language: "en";
    in property <string> keys-list: "";
    in-out property <string> chunk-size-minutes: "10";
    in-out property <bool> auto-extract: false;
    in-out property <bool> use-cookies: false;
    in-out property <string> cookies-path: "";
    in-out property <string> naming-template: "short_%Y%m%d_%H%M%S";
    in-out property <bool> use-fast-model: true;
    in-out property <string> model-fast-name: "gemini-2.5-flash";
    in-out property <string> model-pro-name: "gemini-2.5-pro";
    in-out property <string> new-key-value: "";
    in property <string> models-list: "";
    in-out property <string> new-model-display-name: "";
    in-out property <string> new-model-id: "";
    in-out property <string> new-model-base: "gemini";
    in-out property <string> new-model-temp: "";
    in property <[KeyRow]> keys-model: [];
    in property <int> selected-key-index: -1;
    in property <[ModelRow]> models-model: [];
    in property <string> selected-model-id: "";
    in property <bool> show-key-drawer: false;
    in property <bool> show-model-drawer: false;

    in property <string> tr-navigate: "Navigate";
    in property <string> tr-home: "Inicio";
    in property <string> tr-new-project: "Nuevo";
    in property <string> tr-export-standalone: "Export Standalone";
    in property <string> tr-settings: "Settings";
    in property <string> tr-keys: "AI / Keys";
    in property <string> tr-home-recent: "Recent projects";
    in property <string> tr-home-empty: "No projects yet. Create a new project to start.";
    in property <string> tr-new-project-title: "Video";
    in property <string> tr-new-project-description: "Pega una URL, verifica el video y lanza el analisis. El progreso se guarda por video y se verifica en cada etapa.";
    in property <string> tr-source-step: "01  /  VIDEO";
    in property <string> tr-analysis-step: "02  /  ANALISIS";
    in property <string> tr-analysis-settings: "Analysis settings are managed in Settings and AI / Keys.";
    in property <string> tr-url-label: "YouTube URL";
    in property <string> tr-fetch: "Fetch Info";
    in property <string> tr-fetching: "Fetching video info...";
    in property <string> tr-video-preview: "Video preview";
    in property <string> tr-video-duration: "Duration";
    in property <string> tr-video-id: "ID";
    in property <string> tr-video-no-thumb: "No thumbnail";
    in property <string> tr-video-found: "Video loaded";
    in property <string> tr-export-title: "Export Standalone";
    in property <string> tr-export-desc: "Select clips and a plano to export without AI.";
    in property <string> tr-keys-title: "AI / Keys";
    in property <string> tr-keys-description: "Configure the provider and manage the credentials used by analysis.";
    in property <string> tr-settings-title: "Settings";
    in property <string> tr-settings-description: "Defaults used when importing, analyzing and exporting videos.";
    in property <string> tr-general-section: "GENERAL";
    in property <string> tr-processing-section: "PROCESSING";
    in property <string> tr-auth-section: "AUTHENTICATED SOURCES";
    in property <string> tr-export-section: "EXPORT";
    in property <string> tr-save: "Save changes";
    in property <string> tr-analyze: "Start analysis";
    in property <string> tr-browse: "Browse";
    in property <string> tr-output-dir: "Output directory";
    in property <string> tr-language: "Language";
    in property <string> tr-key-value: "API key";
    in property <string> tr-add: "Add key";
    in property <string> tr-chunk-size: "Chunk duration (minutes)";
    in property <string> tr-auto-extract: "Extract shorts automatically after analysis";
    in property <string> tr-use-cookies: "Use browser cookies for yt-dlp";
    in property <string> tr-cookies-path: "Cookies file";
    in property <string> tr-naming-template: "Output naming template";
    in property <string> tr-model: "Analysis model";
    in property <string> tr-model-display-name: "Display name";
    in property <string> tr-model-id-label: "Model ID";
    in property <string> tr-model-base: "Base provider";
    in property <string> tr-model-drawer-title: "Add model";
    in property <string> tr-model-drawer-description: "Add a video-capable model to the shared model list.";
    in property <string> tr-model-identity: "MODEL IDENTITY";
    in property <string> tr-model-provider: "PROVIDER";
    in property <string> tr-model-temperature: "Temperature (0.0-2.0)";
    in property <string> tr-cancel: "Cancel";
    in property <string> tr-add-model: "Add model";
    in property <string> tr-select-model: "Select";
    in property <string> tr-delete-model: "Delete";
    in property <string> tr-models-title: "Available models";
    in property <string> tr-ai-description: "Choose the model used for video analysis. This setting is shared by every project.";
    in property <string> tr-ai-section: "AI PROVIDER";
    in property <string> tr-keys-section: "API KEYS";
    in property <string> tr-key-description: "Paste an API key. Its display name is generated automatically.";
    in property <string> tr-no-keys: "No API keys configured yet.";
    in property <string> tr-export-workspace: "Export workspace";
    in property <string> tr-export-workspace-description: "Plano editor and batch export will appear here.";
    in property <string> tr-deps-missing: "Missing tools";
    in property <string> tr-deps-recheck: "Re-check";
    in property <string> tr-toggle-key: "Toggle last";
    in property <string> tr-delete-key: "Delete last";
    in property <string> tr-test-connection: "Test connection";
    in property <string> tr-deps-installing: "Installing tools...";
    in property <string> tr-deps-install: "Install automatically";
    in property <string> tr-analysis-log-title: "Technical log (yt-dlp / ffmpeg)";
    in property <string> tr-analysis-log-toggle: "Show details";
    in property <string> tr-analysis-log-empty: "No output yet — details will appear here while yt-dlp and ffmpeg run.";
    in property <string> tr-step-downloading: "Downloading (low res for analysis)";
    in property <string> tr-step-splitting: "Splitting video";
    in property <string> tr-step-analyzing: "Analyzing";
    in property <string> tr-step-extracting: "Extracting shorts";
    in property <string> tr-step-saving: "Saving";
    in property <string> tr-structure: "Structure";
    in property <string> tr-structure-title: "Structure";
    in property <string> tr-structure-desc: "Visual composition";
    in property <string> tr-structure-empty: "Empty canvas.";
    in property <string> tr-structure-no-video: "No video loaded.";
    in property <string> tr-structure-save: "Save structure";
    in property <string> tr-structure-save-template: "Save as global template";
    in property <string> tr-structure-restore-template: "Restore global template";
    in property <string> tr-structure-load-preset: "Load default preset";
    in property <[StructureVideoRow]> structure-videos-model: [];
    in property <[StructureLayerRow]> structure-layers-model: [];
    in property <[CanvasLayer]> structure-canvas-layers: [];
    in property <[MomentRow]> structure-moments-model: [];
    in-out property <string> structure-selected-video-id: "";
    in-out property <string> structure-selected-layer-id: "";
    in property <string> structure-status: "";
    in property <bool> structure-has-video: false;
    in property <string> structure-inspector-name: "";
    in property <string> structure-inspector-type: "";
    in-out property <string> structure-inspector-x: "";
    in-out property <string> structure-inspector-y: "";
    in-out property <string> structure-inspector-w: "";
    in-out property <string> structure-inspector-h: "";
    in property <bool> structure-inspector-has-selection: false;
    in-out property <string> structure-preview-second: "0";
    in property <image> structure-preview-image;
    in property <bool> structure-preview-rendering: false;
    in property <string> structure-preview-status: "";
    in property <bool> structure-preview-has-frame: false;
    in-out property <string> structure-export-resolution: "1080x1920";
    in-out property <string> structure-export-quality: "high";
    in-out property <string> structure-export-fps: "30";
    in property <bool> structure-export-running: false;
    in property <int> structure-export-completed: 0;
    in property <int> structure-export-total: 0;
    in property <string> structure-export-status: "";
    in property <string> deps-error: "";
    in property <bool> deps-ok: true;
    in property <bool> deps-installing: false;
    in property <string> home-recent-list: "";
    in property <string> settings-status: "";
    in property <string> keys-status: "";
    in property <string> models-status: "";
    in property <string> toast-msg: "";
    // Analysis progress state — per-panel, not shared
    in property <bool> is-analyzing: false;
    in property <int> analysis-current-step: 0;
    in property <int> analysis-total-steps: 4;
    in property <string> analysis-step-label: "";
    in property <string> analysis-log: "";
    in property <[string]> analysis-log-lines: [];
    in property <bool> analysis-log-expanded: false;
    in property <float> analysis-anim: 0.0;
    in-out property <length> analysis-log-scroll-y: 0px;

    callback navigate(string);
    callback fetch-info();
    callback start-analyze();
    callback save-settings();
    callback save-ai-settings();
    callback browse-output();
    callback browse-cookies();
    callback add-key();
    callback delete-key();
    callback toggle-key();
    callback test-connection();
    callback check-deps();
    callback add-model();
    callback select-model();
    callback delete-model();
    callback select-key(int);
    callback delete-key-at(int);
    callback toggle-key-at(int);
    callback open-key-drawer();
    callback close-key-drawer();
    callback open-model-drawer();
    callback close-model-drawer();
    callback select-model-id(string);
    callback delete-model-id(string);
    callback toggle-analysis-log();
    callback select-structure-video(string);
    callback save-structure();
    callback save-global-template();
    callback restore-global-template();
    callback load-structure-preset();
    callback select-structure-layer(string);
    callback move-structure-layer(string, float, float);
    callback resize-structure-layer(string, string, float, float);
    callback toggle-structure-layer(string);
    callback delete-structure-layer(string);
    callback raise-structure-layer(string);
    callback lower-structure-layer(string);
    callback commit-structure-position();
    callback commit-structure-size();
    callback add-structure-clip();
    callback add-structure-image();
    callback add-structure-video();
    callback add-structure-blur();
    callback render-structure-preview();
    callback render-structure-sample();
    callback toggle-structure-moment(int);
    callback start-structure-export();
    callback cancel-structure-export();
    callback retry-structure-export();

    HorizontalLayout {
        Rectangle {
            width: 210px;
            background: #18181b;
            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                alignment: start;

                VerticalLayout {
                    spacing: 2px;
                    Text { text: "yt-shortmaker v2"; color: #ffffff; font-size: 14px; font-weight: 700; }
                    Text { text: core-version; color: #71717a; font-size: 11px; }
                }

                Rectangle { height: 1px; background: #27272a; }
                Text { text: root.tr-navigate; color: #71717a; font-size: 11px; font-weight: 600; }

                VerticalLayout {
                    spacing: 2px;
                    NavItem { label: root.tr-home; active: route == "home" || route == "new-project"; clicked => { root.navigate("home"); } }
                    NavItem { label: root.tr-structure; active: route == "structure"; clicked => { root.navigate("structure"); } }
                    NavItem { label: root.tr-export-standalone; active: route == "export"; clicked => { root.navigate("export"); } }
                    NavItem { label: root.tr-settings; active: route == "settings"; clicked => { root.navigate("settings"); } }
                    NavItem { label: root.tr-keys; active: route == "keys"; clicked => { root.navigate("keys"); } }
                }
            }
        }

        Rectangle { width: 1px; background: #27272a; }

        Rectangle {
            horizontal-stretch: 1;
            background: #121214;
            VerticalLayout {
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 24px;
                        spacing: 16px;
                        alignment: start;

                    if route == "home" || route == "new-project": VerticalLayout {
                        alignment: start;
                        spacing: 12px;
                        Text { text: root.tr-new-project-title; color: #ffffff; font-size: 17px; font-weight: 700; }
                        Text { text: root.tr-new-project-description; color: #b9bdc5; font-size: 13px; }
                        if !root.deps-ok: Rectangle {
                            background: #2a1515;
                            border-width: 1px;
                            border-color: #7f1d1d;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 8px;
                                Text { text: root.tr-deps-missing; color: #fca5a5; font-size: 12px; font-weight: 700; }
                                Text { text: root.tr-deps-installing; color: #fca5a5; font-size: 11px; wrap: word-wrap; }
                            }
                        }
                        Rectangle { height: 1px; background: #27272a; }
                        Text { text: root.tr-url-label; color: #e4e4e7; font-size: 12px; font-weight: 600; }
                        HorizontalLayout {
                            spacing: 8px;
                            SquareInput {
                                text <=> root.url-input;
                                placeholder-text: "https://youtube.com/watch?v=...";
                                horizontal-stretch: 1;
                            }
                            SquareButton { label: root.tr-fetch; primary: true; width: 110px; clicked => { root.fetch-info(); } }
                        }
                        if url-error != "": Rectangle {
                            background: #2a1515;
                            border-width: 1px;
                            border-color: #7f1d1d;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 4px;
                                Text { text: url-error; color: #fca5a5; font-size: 12px; wrap: word-wrap; }
                            }
                        }
                        if root.video-has-info: Rectangle {
                            background: #1a1a1e;
                            border-width: 1px;
                            border-color: #27272a;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 10px;
                                Text { text: root.tr-video-preview; color: #818cf8; font-size: 11px; font-weight: 700; }
                                HorizontalLayout {
                                    spacing: 14px;
                                    Rectangle {
                                        width: 160px;
                                        height: 90px;
                                        background: #252629;
                                        border-width: 1px;
                                        border-color: #3a3c42;
                                        Image {
                                            width: parent.width;
                                            height: parent.height;
                                            source: root.video-thumbnail-image;
                                            image-fit: cover;
                                        }
                                        if root.video-thumbnail-image.width == 0: Text {
                                            width: parent.width;
                                            height: parent.height;
                                            text: root.tr-video-no-thumb;
                                            color: #858b96;
                                            font-size: 11px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 6px;
                                        horizontal-stretch: 1;
                                        Text { text: root.video-title; color: #ffffff; font-size: 13px; font-weight: 600; wrap: word-wrap; }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text { text: root.tr-video-id + ":"; color: #71717a; font-size: 11px; }
                                            Text { text: root.video-id; color: #a1a1aa; font-size: 11px; }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text { text: root.tr-video-duration + ":"; color: #71717a; font-size: 11px; }
                                            Text { text: root.video-duration; color: #a1a1aa; font-size: 11px; }
                                        }
                                        if root.video-thumbnail != "": Text { text: root.video-thumbnail; color: #6366f1; font-size: 9px; wrap: word-wrap; }
                                    }
                                }
                            }
                        }
                        Rectangle { height: 1px; background: #27272a; }
                        Text { text: root.tr-analysis-step; color: #e4e4e7; font-size: 12px; font-weight: 600; }
                        Text { text: root.tr-analysis-settings; color: #9ca3af; font-size: 12px; }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            SquareButton { label: root.tr-analyze; primary: true; width: 140px; clicked => { root.start-analyze(); } }
                            if root.is-analyzing: Text { text: "> " + root.analysis-step-label; color: #818cf8; font-size: 11px; vertical-alignment: center; }
                        }
                        // Step indicator + status
                        if root.is-analyzing || root.analysis-current-step > 0: Rectangle {
                            background: #1a1a1e;
                            border-width: 1px;
                            border-color: #27272a;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 6px;
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: root.analysis-current-step + "/" + root.analysis-total-steps + " - " + root.analysis-step-label;
                                        color: #e4e4e7;
                                        font-size: 12px;
                                        font-weight: 600;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    if root.is-analyzing: Text { text: "Working"; color: #6366f1; font-size: 11px; }
                                }
                                // Dots for steps
                                HorizontalLayout {
                                    spacing: 4px;
                                    for i in 4: Rectangle {
                                        width: 22px;
                                        height: 4px;
                                        background: i < root.analysis-current-step ? #6366f1 : #27272a;
                                        border-width: 1px;
                                        border-color: i < root.analysis-current-step ? #6366f1 : #3a3c42;
                                        if i + 1 == root.analysis-current-step && root.is-analyzing: Rectangle {
                                            width: parent.width;
                                            height: parent.height;
                                            background: #818cf8;
                                            opacity: 0.7;
                                        }
                                    }
                                }
                                if status-msg != "": Text { text: status-msg; color: #c3c6cc; font-size: 11px; wrap: word-wrap; }
                            }
                        }
                        if !root.is-analyzing && root.analysis-current-step == 0 && status-msg != "": Rectangle {
                            background: #1a1a1e;
                            border-width: 1px;
                            border-color: #27272a;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 4px;
                                Text { text: status-msg; color: #c3c6cc; font-size: 12px; wrap: word-wrap; }
                            }
                        }
                        // Animated progress bar — determinate fill + shimmer when working
                        Rectangle {
                            height: 6px;
                            background: #27272a;
                            border-width: 1px;
                            border-color: #3a3c42;
                            clip: true;
                            Rectangle {
                                x: 0px;
                                width: parent.width * progress;
                                height: parent.height;
                                background: #6366f1;
                            }
                            if root.is-analyzing && progress < 1.0: Rectangle {
                                width: 90px;
                                height: parent.height;
                                background: #818cf8;
                                opacity: 0.95;
                                x: (parent.width - 90px) * root.analysis-anim;
                            }
                        }
                        // Collapsible technical log (yt-dlp / ffmpeg)
                        Rectangle {
                            background: #1a1a1e;
                            border-width: 1px;
                            border-color: #27272a;
                            VerticalLayout {
                                spacing: 0px;
                                Rectangle {
                                    height: 32px;
                                    background: #202124;
                                    border-width: 1px;
                                    border-color: #3a3c42;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 8px;
                                        spacing: 8px;
                                        Text {
                                            text: root.tr-analysis-log-title;
                                            color: #e4e4e7;
                                            font-size: 11px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: root.analysis-log-expanded ? "v" : ">";
                                            color: #a1a1aa;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: root.tr-analysis-log-toggle;
                                            color: #a1a1aa;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                    }
                                    TouchArea { clicked => { root.toggle-analysis-log(); } }
                                }
                                if root.analysis-log-expanded: Rectangle {
                                    height: 300px;
                                    background: #121214;
                                    border-width: 1px;
                                    border-color: #27272a;
                                    ScrollView {
                                        viewport-y: root.analysis-log-scroll-y;
                                        VerticalLayout {
                                            padding: 8px;
                                            spacing: 2px;
                                            if root.analysis-log-lines.length == 0: Text {
                                                text: root.tr-analysis-log-empty;
                                                color: #71717a;
                                                font-size: 11px;
                                                wrap: word-wrap;
                                            }
                                            for line in root.analysis-log-lines: Text {
                                                text: line;
                                                color: #d4d4d8;
                                                font-size: 10px;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if route == "structure": StructureEditor {
                        title: root.tr-structure-title;
                        description: root.tr-structure-desc;
                        status: root.structure-status;
                        has-video: root.structure-has-video;
                        empty-text: root.structure-has-video ? root.tr-structure-empty : root.tr-structure-no-video;
                        save-label: root.tr-structure-save;
                        preset-label: root.tr-structure-load-preset;
                        template-label: root.tr-structure-save-template;
                        restore-label: root.tr-structure-restore-template;
                        canvas-layers: root.structure-canvas-layers;
                        layers-model: root.structure-layers-model;
                        videos-model: root.structure-videos-model;
                        selected-video-id <=> root.structure-selected-video-id;
                        selected-layer-id <=> root.structure-selected-layer-id;
                        select-video(id) => { root.select-structure-video(id); }
                        inspector-name: root.structure-inspector-name;
                        inspector-type: root.structure-inspector-type;
                        inspector-x <=> root.structure-inspector-x;
                        inspector-y <=> root.structure-inspector-y;
                        inspector-w <=> root.structure-inspector-w;
                        inspector-h <=> root.structure-inspector-h;
                        inspector-has-selection: root.structure-inspector-has-selection;
                        preview-second-text <=> root.structure-preview-second;
                        preview-static-image: root.structure-preview-image;
                        preview-rendering: root.structure-preview-rendering;
                        preview-status: root.structure-preview-status;
                        preview-has-frame: root.structure-preview-has-frame;
                        save-structure => { root.save-structure(); }
                        save-global-template => { root.save-global-template(); }
                        restore-global-template => { root.restore-global-template(); }
                        load-preset => { root.load-structure-preset(); }
                        add-clip-layer => { root.add-structure-clip(); }
                        add-image-layer => { root.add-structure-image(); }
                        add-video-layer => { root.add-structure-video(); }
                        add-blur-layer => { root.add-structure-blur(); }
                        select-layer(id) => { root.select-structure-layer(id); }
                        drag-layer(id, dx, dy) => { root.move-structure-layer(id, dx, dy); }
                        resize-layer(id, handle, dx, dy) => { root.resize-structure-layer(id, handle, dx, dy); }
                        toggle-layer(id) => { root.toggle-structure-layer(id); }
                        delete-layer(id) => { root.delete-structure-layer(id); }
                        raise-layer(id) => { root.raise-structure-layer(id); }
                        lower-layer(id) => { root.lower-structure-layer(id); }
                        commit-position => { root.commit-structure-position(); }
                        commit-size => { root.commit-structure-size(); }
                        render-preview-frame => { root.render-structure-preview(); }
                        render-preview-sample => { root.render-structure-sample(); }
                        moments-model: root.structure-moments-model;
                        export-resolution <=> root.structure-export-resolution;
                        export-quality <=> root.structure-export-quality;
                        export-fps <=> root.structure-export-fps;
                        export-running: root.structure-export-running;
                        export-completed: root.structure-export-completed;
                        export-total: root.structure-export-total;
                        export-status: root.structure-export-status;
                        toggle-moment(idx) => { root.toggle-structure-moment(idx); }
                        start-export => { root.start-structure-export(); }
                        cancel-export => { root.cancel-structure-export(); }
                        retry-failed => { root.retry-structure-export(); }
                    }

                    if route == "export": VerticalLayout {
                        alignment: start;
                        spacing: 12px;
                        Text { text: root.tr-export-title; color: #ffffff; font-size: 17px; font-weight: 700; }
                        Rectangle { height: 1px; background: #27272a; }
                        Text { text: root.tr-export-desc; color: #b9bdc5; font-size: 13px; wrap: word-wrap; }
                        Rectangle {
                            height: 120px;
                            background: #1a1a1e;
                            border-width: 1px;
                            border-color: #27272a;
                            Text { x: 16px; y: 16px; text: root.tr-export-workspace; color: #e4e4e7; font-size: 13px; font-weight: 600; }
                            Text { x: 16px; y: 46px; text: root.tr-export-workspace-description; color: #b9bdc5; font-size: 12px; }
                        }
                    }

                    if route == "settings": VerticalLayout {
                        alignment: start;
                        spacing: 14px;
                        Text { text: root.tr-settings-title; color: #ffffff; font-size: 17px; font-weight: 700; }
                        Text { text: root.tr-settings-description; color: #b9bdc5; font-size: 13px; }
                        Rectangle { height: 1px; background: #27272a; }

                        Text { text: root.tr-general-section; color: #818cf8; font-size: 11px; font-weight: 700; }
                        Text { text: root.tr-output-dir; color: #e4e4e7; font-size: 12px; font-weight: 600; }
                        HorizontalLayout {
                            spacing: 8px;
                            SquareInput { text <=> root.output-dir; placeholder-text: "/path/to/output"; horizontal-stretch: 1; }
                            SquareButton { label: root.tr-browse; width: 90px; clicked => { root.browse-output(); } }
                        }
                        HorizontalLayout {
                            spacing: 24px;
                            VerticalLayout {
                                spacing: 6px;
                                Text { text: root.tr-language; color: #e4e4e7; font-size: 12px; font-weight: 600; }
                                HorizontalLayout {
                                    spacing: 4px;
                                    SquareChoice { label: "en"; selected: root.language == "en"; chosen => { root.language = "en"; } }
                                    SquareChoice { label: "es"; selected: root.language == "es"; chosen => { root.language = "es"; } }
                                    SquareChoice { label: "ru"; selected: root.language == "ru"; chosen => { root.language = "ru"; } }
                                }
                            }
                        }

                        Text { text: root.tr-processing-section; color: #818cf8; font-size: 11px; font-weight: 700; }
                        Text { text: root.tr-chunk-size; color: #e4e4e7; font-size: 12px; font-weight: 600; }
                        SquareInput { text <=> root.chunk-size-minutes; placeholder-text: "10"; width: 140px; }
                        SquareToggle { label: root.tr-auto-extract; checked <=> root.auto-extract; }

                        Text { text: root.tr-auth-section; color: #818cf8; font-size: 11px; font-weight: 700; }
                        SquareToggle { label: root.tr-use-cookies; checked <=> root.use-cookies; }
                        if root.use-cookies: HorizontalLayout {
                            spacing: 8px;
                            SquareInput { text <=> root.cookies-path; placeholder-text: "/path/to/cookies.txt"; horizontal-stretch: 1; }
                            SquareButton { label: root.tr-browse; width: 90px; clicked => { root.browse-cookies(); } }
                        }

                        Text { text: root.tr-export-section; color: #818cf8; font-size: 11px; font-weight: 700; }
                        Text { text: root.tr-naming-template; color: #e4e4e7; font-size: 12px; font-weight: 600; }
                        SquareInput { text <=> root.naming-template; placeholder-text: "short_%Y%m%d_%H%M%S"; }
                        HorizontalLayout {
                            spacing: 8px;
                            SquareButton { label: root.tr-save; primary: true; width: 110px; clicked => { root.save-settings(); } }
                            Text { text: root.settings-status; color: #86efac; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
                        }
                    }

                    if route == "keys": VerticalLayout {
                        alignment: start;
                        spacing: 14px;
                        Text { text: root.tr-keys-title; color: #ffffff; font-size: 17px; font-weight: 700; }
                        Text { text: root.tr-keys-description; color: #b9bdc5; font-size: 13px; wrap: word-wrap; }
                        Rectangle { height: 1px; background: #27272a; }

                        Text { text: root.tr-ai-section; color: #818cf8; font-size: 11px; font-weight: 700; }
                        Text { text: root.tr-ai-description; color: #b9bdc5; font-size: 12px; wrap: word-wrap; }
                        Text { text: root.tr-models-title; color: #e4e4e7; font-size: 12px; font-weight: 600; }
                        Rectangle {
                            background: #1a1a1e;
                            border-width: 1px;
                            border-color: #27272a;
                            height: 150px;
                            ScrollView {
                                VerticalLayout {
                                    padding: 6px;
                                    spacing: 2px;
                                    if root.models-model.length == 0: Text { text: root.tr-no-keys; color: #858b96; font-size: 11px; horizontal-alignment: center; }
                                    for m in root.models-model: Rectangle {
                                        height: 34px;
                                        background: m.active ? #2a2a2e : transparent;
                                        border-width: 1px;
                                        border-color: m.active ? #6366f1 : #27272a;
                                        TouchArea { clicked => { root.select-model-id(m.id); } }
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 6px;
                                            spacing: 8px;
                                            Text { text: m.active ? ">" : " "; color: #6366f1; font-size: 10px; width: 12px; vertical-alignment: center; }
                                            VerticalLayout {
                                                spacing: 1px;
                                                vertical-stretch: 1;
                                                alignment: center;
                                                Text { text: m.display_name; color: #ffffff; font-size: 12px; font-weight: 500; }
                                                Text { text: m.model_id + " (" + m.base + ")"; color: #a1a1aa; font-size: 10px; }
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            SquareButton { label: root.tr-select-model; width: 70px; height: 24px; clicked => { root.select-model-id(m.id); } }
                                            SquareButton { label: root.tr-delete-model; width: 60px; height: 24px; clicked => { root.delete-model-id(m.id); } }
                                        }
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            SquareButton { label: root.tr-add-model; primary: true; width: 120px; clicked => { root.open-model-drawer(); } }
                            Text { text: root.models-status; color: #86efac; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
                        }

                        Rectangle { height: 1px; background: #27272a; }
                        Text { text: root.tr-keys-section; color: #818cf8; font-size: 11px; font-weight: 700; }
                        Text { text: root.tr-key-description; color: #b9bdc5; font-size: 12px; wrap: word-wrap; }
                        Rectangle {
                            background: #1a1a1e;
                            border-width: 1px;
                            border-color: #27272a;
                            height: 150px;
                            ScrollView {
                                VerticalLayout {
                                    padding: 6px;
                                    spacing: 2px;
                                    if root.keys-model.length == 0: Text { text: root.tr-no-keys; color: #858b96; font-size: 11px; horizontal-alignment: center; }
                                    for k in root.keys-model: Rectangle {
                                        height: 32px;
                                        background: k.index == root.selected-key-index ? #2a2a2e : transparent;
                                        border-width: 1px;
                                        border-color: k.index == root.selected-key-index ? #6366f1 : #27272a;
                                        TouchArea { clicked => { root.select-key(k.index); } }
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 6px;
                                            spacing: 8px;
                                            Text { text: k.name; color: #ffffff; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                                            Text { text: k.enabled ? "[on]" : "[off]"; color: k.enabled ? #86efac : #f87171; font-size: 10px; vertical-alignment: center; }
                                            SquareButton { label: "On/Off"; width: 60px; height: 24px; clicked => { root.toggle-key-at(k.index); } }
                                            SquareButton { label: "Borrar"; width: 60px; height: 24px; clicked => { root.delete-key-at(k.index); } }
                                        }
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            SquareButton { label: root.tr-add; primary: true; width: 120px; clicked => { root.open-key-drawer(); } }
                            SquareButton { label: root.tr-test-connection; width: 130px; clicked => { root.test-connection(); } }
                            Text { text: root.keys-status; color: #c3c6cc; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
                        }
                    }
                }
            }
                if root.toast-msg != "": Rectangle {
                    height: 36px;
                    background: #1e1e21;
                    border-width: 1px;
                    border-color: #3a3c42;
                    Text {
                        x: 12px;
                        width: parent.width - 24px;
                        height: parent.height;
                        text: root.toast-msg;
                        color: #e4e4e7;
                        font-size: 12px;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
        // Lateral drawers — overlay + sliding panel (square, dark, no radius)
        if root.show-key-drawer: Rectangle {
            width: parent.width;
            height: parent.height;
            background: #000000;
            opacity: 0.45;
            TouchArea { clicked => { root.close-key-drawer(); } }
        }
        if root.show-key-drawer: Rectangle {
            x: parent.width - 380px;
            width: 380px;
            height: parent.height;
            background: #18181b;
            border-width: 1px;
            border-color: #27272a;
            animate x { duration: 180ms; easing: ease-in-out; }
            TouchArea { }
            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                Text { text: "Añadir Clave API"; color: #ffffff; font-size: 14px; font-weight: 700; }
                Text { text: root.tr-key-description; color: #b9bdc5; font-size: 12px; wrap: word-wrap; }
                Text { text: root.tr-key-value; color: #e4e4e7; font-size: 11px; font-weight: 600; }
                SquareInput { text <=> root.new-key-value; placeholder-text: "AIza..."; password: true; }
                HorizontalLayout {
                    spacing: 8px;
                    SquareButton { label: root.tr-add; primary: true; width: 110px; clicked => { root.add-key(); } }
                    SquareButton { label: "Cancelar"; width: 110px; clicked => { root.close-key-drawer(); } }
                }
                Text { text: root.keys-status; color: #86efac; font-size: 11px; wrap: word-wrap; }
            }
        }
        if root.show-model-drawer: Rectangle {
            width: parent.width;
            height: parent.height;
            background: #000000;
            opacity: 0.45;
            TouchArea { clicked => { root.close-model-drawer(); } }
        }
        if root.show-model-drawer: ModelDrawer {
            x: parent.width - 400px;
            height: parent.height;
            display-name <=> root.new-model-display-name;
            model-id <=> root.new-model-id;
            base-provider <=> root.new-model-base;
            temperature <=> root.new-model-temp;
            title: root.tr-model-drawer-title;
            description: root.tr-model-drawer-description;
            identity-label: root.tr-model-identity;
            provider-label: root.tr-model-provider;
            display-name-label: root.tr-model-display-name;
            model-id-label: root.tr-model-id-label;
            base-provider-label: root.tr-model-base;
            temperature-label: root.tr-model-temperature;
            add-label: root.tr-add-model;
            cancel-label: root.tr-cancel;
            status: root.models-status;
            add-model => { root.add-model(); }
            close => { root.close-model-drawer(); }
        }
}
