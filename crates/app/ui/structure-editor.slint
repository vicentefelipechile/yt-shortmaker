import { StructureToolbar } from "./structure-toolbar.slint";
import { StructureCanvas } from "./structure-canvas.slint";
import { StructureDock } from "./structure-dock.slint";
import { CanvasLayer, MomentRow, StructureAssetRow, StructureLayerRow, StructureLogRow, StructureVideoRow } from "./structure-types.slint";

export component StructureEditor inherits Rectangle {
    in property <string> title: "Structure";
    in property <string> description: "";
    in property <string> status: "";
    in property <bool> has-video: false;
    in property <string> active-video-title: "No video";
    in property <string> active-video-meta: "";
    in property <bool> document-dirty: false;
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;
    in property <[CanvasLayer]> canvas-layers: [];
    in property <[StructureLayerRow]> layers-model: [];
    in property <[StructureVideoRow]> videos-model: [];
    in property <[StructureAssetRow]> assets-model: [];
    in property <[MomentRow]> moments-model: [];
    in property <[StructureLogRow]> logs-model: [];
    in-out property <string> selected-video-id: "";
    in-out property <string> selected-layer-id: "";
    in-out property <string> active-dock-tab: "layers";
    in-out property <float> zoom: 0.3;
    in property <string> inspector-name: "";
    in property <string> inspector-type: "";
    in-out property <string> inspector-x: "";
    in-out property <string> inspector-y: "";
    in-out property <string> inspector-w: "";
    in-out property <string> inspector-h: "";
    in property <bool> inspector-has-selection: false;
    in-out property <string> preview-second-text: "0";
    in property <image> preview-static-image;
    in property <bool> preview-rendering: false;
    in property <string> preview-status: "";
    in property <string> preview-sample-path: "";
    in property <bool> preview-has-frame: false;
    in-out property <string> export-resolution: "1080x1920";
    in-out property <string> export-quality: "high";
    in-out property <string> export-fps: "30";
    in property <bool> export-running: false;
    in property <int> export-completed: 0;
    in property <int> export-total: 0;
    in property <string> export-status: "";

    callback select-video(string);
    callback save-structure();
    callback save-global-template();
    callback restore-global-template();
    callback add-clip-layer();
    callback add-image-layer();
    callback add-video-layer();
    callback add-blur-layer();
    callback undo();
    callback redo();
    callback select-layer(string);
    callback drag-start(string);
    callback drag-layer(string, float, float);
    callback drag-finish(string);
    callback resize-start(string);
    callback resize-layer(string, string, float, float);
    callback resize-finish(string);
    callback center-requested();
    callback toggle-layer(string);
    callback delete-layer(string);
    callback raise-layer(string);
    callback lower-layer(string);
    callback commit-position();
    callback commit-size();
    callback render-preview-frame();
    callback render-preview-sample();
    callback open-preview-sample();
    callback clear-logs();
    callback open-log-file();
    callback toggle-moment(int);
    callback start-export();
    callback cancel-export();
    callback retry-failed();

    background: #121214;

    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        Text { text: root.title; color: #ffffff; font-size: 17px; font-weight: 700; }
        Text { text: root.description; color: #b9bdc5; font-size: 12px; wrap: word-wrap; }
        StructureToolbar {
            horizontal-stretch: 1;
            video-title: root.active-video-title;
            video-meta: root.active-video-meta;
            has-video: root.has-video;
            dirty: root.document-dirty;
            can-undo: root.can-undo;
            can-redo: root.can-redo;
            active-tab: root.active-dock-tab;
            videos-model: root.videos-model;
            select-video(id) => { root.select-video(id); }
            add-clip => { root.add-clip-layer(); }
            add-image => { root.add-image-layer(); }
            add-video => { root.add-video-layer(); }
            add-blur => { root.add-blur-layer(); }
            undo => { root.undo(); }
            redo => { root.redo(); }
            fit-frame => { canvas.fit-frame(); }
            zoom-out => { canvas.request-zoom-out(); }
            zoom-in => { canvas.request-zoom-in(); }
            save => { root.save-structure(); }
            save-template => { root.save-global-template(); }
            restore-template => { root.restore-global-template(); }
            select-tab(tab) => { root.active-dock-tab = tab; }
        }
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 8px;
            canvas := StructureCanvas {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                layers: root.canvas-layers;
                selected-layer-id: root.selected-layer-id;
                selected-video-id: root.selected-video-id;
                zoom <=> root.zoom;
                select-layer(id) => { root.select-layer(id); }
                drag-start(id) => { root.drag-start(id); }
                drag-layer(id, dx, dy) => { root.drag-layer(id, dx, dy); }
                drag-finish(id) => { root.drag-finish(id); }
                resize-start(id) => { root.resize-start(id); }
                resize-layer(id, handle, dx, dy) => { root.resize-layer(id, handle, dx, dy); }
                resize-finish(id) => { root.resize-finish(id); }
                request-center => { root.center-requested(); }
            }
            StructureDock {
                vertical-stretch: 1;
                active-tab <=> root.active-dock-tab;
                layers-model: root.layers-model;
                assets-model: root.assets-model;
                moments-model: root.moments-model;
                logs-model: root.logs-model;
                selected-layer-id: root.selected-layer-id;
                inspector-name: root.inspector-name;
                inspector-type: root.inspector-type;
                inspector-x <=> root.inspector-x;
                inspector-y <=> root.inspector-y;
                inspector-w <=> root.inspector-w;
                inspector-h <=> root.inspector-h;
                inspector-has-selection: root.inspector-has-selection;
                preview-second <=> root.preview-second-text;
                preview-image: root.preview-static-image;
                preview-rendering: root.preview-rendering;
                preview-status: root.preview-status;
                preview-sample-path: root.preview-sample-path;
                preview-has-frame: root.preview-has-frame;
                export-resolution <=> root.export-resolution;
                export-quality <=> root.export-quality;
                export-fps <=> root.export-fps;
                export-running: root.export-running;
                export-completed: root.export-completed;
                export-total: root.export-total;
                export-status: root.export-status;
                select-tab(tab) => { root.active-dock-tab = tab; }
                import-asset => { root.add-image-layer(); }
                select-layer(id) => { root.select-layer(id); }
                toggle-layer(id) => { root.toggle-layer(id); }
                delete-layer(id) => { root.delete-layer(id); }
                raise-layer(id) => { root.raise-layer(id); }
                lower-layer(id) => { root.lower-layer(id); }
                commit-position => { root.commit-position(); }
                commit-size => { root.commit-size(); }
                render-frame => { root.render-preview-frame(); }
                render-sample => { root.render-preview-sample(); }
                open-sample => { root.open-preview-sample(); }
                clear-logs => { root.clear-logs(); }
                open-log-file => { root.open-log-file(); }
                toggle-moment(idx) => { root.toggle-moment(idx); }
                start-export => { root.start-export(); }
                cancel-export => { root.cancel-export(); }
                retry-export => { root.retry-failed(); }
            }
        }
        Rectangle {
            height: 24px;
            background: #1a1a1e;
            border-width: 1px;
            border-color: #27272a;
            Text { x: 8px; width: parent.width - 16px; height: parent.height; text: root.status; color: #b9bdc5; font-size: 11px; vertical-alignment: center; overflow: elide; }
        }
    }
}
