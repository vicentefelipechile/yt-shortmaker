import { ScrollView } from "std-widgets.slint";
import { CanvasLayerItem } from "./structure-layer-item.slint";
import { CanvasLayer } from "./structure-types.slint";

export component StructureCanvas inherits Rectangle {
    in property <[CanvasLayer]> layers: [];
    in-out property <string> selected-layer-id: "";
    in-out property <float> zoom: 0.3;
    in property <int> output-width: 1080;
    in property <int> output-height: 1920;

    callback select-layer(string);
    callback drag-layer(string, float, float);
    callback resize-layer(string, string, float, float);

    property <float> world-width: 12000;
    property <float> world-height: 12000;
    property <float> document-origin-x: (world-width - output-width * root.zoom) / 2;
    property <float> document-origin-y: (world-height - output-height * root.zoom) / 2;

    background: #121214;
    border-width: 1px;
    border-color: #27272a;
    clip: true;

    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 32px;
            background: #1a1a1e;
            Text { x: 10px; text: "Canvas workspace"; color: #818cf8; font-size: 11px; font-weight: 700; vertical-alignment: center; }
            Text { x: parent.width - 205px; width: 195px; text: "Middle drag or Space + drag to pan"; color: #858b96; font-size: 10px; vertical-alignment: center; horizontal-alignment: right; }
        }
        Rectangle { height: 1px; background: #27272a; }
        ScrollView {
            vertical-stretch: 1;
            horizontal-stretch: 1;
            mouse-drag-pan-enabled: true;
            viewport-x: root.document-origin-x * 1px - self.width / 2;
            viewport-y: root.document-origin-y * 1px - self.height / 2;
            viewport-width: root.world-width * 1px;
            viewport-height: root.world-height * 1px;
            horizontal-scrollbar-policy: ScrollBarPolicy.as-needed;
            vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
            Rectangle {
                width: root.world-width * 1px;
                height: root.world-height * 1px;
                background: #101012;
                for col in 120: Rectangle {
                    x: col * 100px;
                    width: 1px;
                    height: parent.height;
                    background: #1b1b1f;
                }
                for row in 120: Rectangle {
                    y: row * 100px;
                    width: parent.width;
                    height: 1px;
                    background: #1b1b1f;
                }
                for layer in root.layers: CanvasLayerItem {
                    layer-id: layer.id;
                    layer-type: layer.layer-type;
                    layer-x: root.document-origin-x / root.zoom + layer.x;
                    layer-y: root.document-origin-y / root.zoom + layer.y;
                    layer-width: layer.width;
                    layer-height: layer.height;
                    layer-visible: layer.visible;
                    selected: layer.selected;
                    zoom: root.zoom;
                    preview-image: layer.preview-image;
                    preview-available: layer.preview-available;
                    asset-name: layer.asset-name;
                    asset-valid: layer.asset-valid;
                    selected-layer => { root.select-layer(layer.id); }
                    dragged(dx, dy) => { root.drag-layer(layer.id, dx, dy); }
                    handle-dragged(handle, dx, dy) => { root.resize-layer(layer.id, handle, dx, dy); }
                }
                Rectangle {
                    x: root.document-origin-x * 1px;
                    y: root.document-origin-y * 1px;
                    width: root.output-width * root.zoom * 1px;
                    height: root.output-height * root.zoom * 1px;
                    border-width: 2px;
                    border-color: #6366f1;
                    background: transparent;
                }
                Text {
                    x: root.document-origin-x * 1px;
                    y: root.document-origin-y * 1px - 22px;
                    text: "OUTPUT 9:16  " + root.output-width + "x" + root.output-height;
                    color: #818cf8;
                    font-size: 10px;
                }
            }
        }
    }
}
