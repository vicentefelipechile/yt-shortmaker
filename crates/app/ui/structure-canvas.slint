import { ScrollView } from "std-widgets.slint";
import { CanvasLayerItem } from "./structure-layer-item.slint";
import { CanvasLayer } from "./structure-types.slint";

export component StructureCanvas inherits Rectangle {
    in property <[CanvasLayer]> layers: [];
    in property <string> selected-layer-id: "";
    in property <string> selected-video-id: "";
    in-out property <float> zoom: 0.3;
    in property <int> output-width: 1080;
    in property <int> output-height: 1920;

    callback select-layer(string);
    callback drag-start(string);
    callback drag-layer(string, float, float);
    callback drag-finish(string);
    callback resize-start(string);
    callback resize-layer(string, string, float, float);
    callback resize-finish(string);
    callback request-center();

    // Viewport state: owned here, bound to ScrollView.
    in-out property <length> view-x: 0px;
    in-out property <length> view-y: 0px;
    in-out property <bool> space-held: false;
    property <bool> view-centered: false;

    // Pan gesture state (screen px, incremental from pointer tracking).
    property <bool> pan-active: false;
    property <float> pan-last-x: 0;
    property <float> pan-last-y: 0;

    property <length> frame-w: root.output-width * root.zoom * 1px;
    property <length> frame-h: root.output-height * root.zoom * 1px;
    property <length> world-w: Math.max(root.frame-w + 800px, scroll.visible-width + 400px);
    property <length> world-h: Math.max(root.frame-h + 800px, scroll.visible-height + 400px);
    property <length> origin-x: (root.world-w - root.frame-w) / 2;
    property <length> origin-y: (root.world-h - root.frame-h) / 2;

    // Grid: one cell per 100 logical px, scaled by zoom and anchored to the
    // frame origin so cells stay aligned with the output frame at any zoom.
    property <float> grid-logical-step: 100;
    property <length> grid-step: Math.max(root.grid-logical-step * root.zoom * 1px, 1px);
    property <int> grid-cols: Math.ceil(root.world-w / root.grid-step) + 3;
    property <int> grid-rows: Math.ceil(root.world-h / root.grid-step) + 3;
    property <length> grid-off-x: Math.mod(root.origin-x / 1px, root.grid-logical-step * root.zoom) * 1px;
    property <length> grid-off-y: Math.mod(root.origin-y / 1px, root.grid-logical-step * root.zoom) * 1px;

    function apply-zoom(req-zoom: float) {
        let cz: float = req-zoom < 0.05 ? 0.05 : req-zoom > 2.0 ? 2.0 : req-zoom;
        if (cz == root.zoom) {
            return;
        }
        if (root.zoom <= 0.001) {
            root.zoom = cz;
            return;
        }
        let cx: float = (-root.view-x + scroll.visible-width / 2 - root.origin-x) / 1px / root.zoom;
        let cy: float = (-root.view-y + scroll.visible-height / 2 - root.origin-y) / 1px / root.zoom;
        root.zoom = cz;
        let nfw: length = root.output-width * cz * 1px;
        let nfh: length = root.output-height * cz * 1px;
        let nww: length = Math.max(nfw + 800px, scroll.visible-width + 400px);
        let nwh: length = Math.max(nfh + 800px, scroll.visible-height + 400px);
        let nox: length = (nww - nfw) / 2;
        let noy: length = (nwh - nfh) / 2;
        root.view-x = -(nox + cx * cz * 1px - scroll.visible-width / 2);
        root.view-y = -(noy + cy * cz * 1px - scroll.visible-height / 2);
    }

    public function request-zoom-in() {
        self.apply-zoom(root.zoom + 0.05);
    }

    public function request-zoom-out() {
        if (root.zoom > 0.1) {
            self.apply-zoom(root.zoom - 0.05);
        } else {
            self.apply-zoom(0.05);
        }
    }

    public function center-frame() {
        root.view-x = -(root.world-w - scroll.visible-width) / 2;
        root.view-y = -(root.world-h - scroll.visible-height) / 2;
        root.view-centered = true;
    }

    public function fit-frame() {
        if (scroll.visible-width <= 0px || scroll.visible-height <= 0px) {
            self.center-frame();
            return;
        }
        let zw: float = scroll.visible-width / 1px / root.output-width;
        let zh: float = scroll.visible-height / 1px / root.output-height;
        let zraw: float = (zw < zh ? zw : zh) * 0.88;
        let z: float = zraw < 0.05 ? 0.05 : zraw > 2.0 ? 2.0 : zraw;
        self.apply-zoom(z);
        self.center-frame();
    }

    public function start-pan(px: float, py: float) {
        root.pan-active = true;
        root.pan-last-x = px;
        root.pan-last-y = py;
        scope.focus();
    }

    public function apply-pan(dx: float, dy: float) {
        root.view-x = root.view-x + dx * 1px;
        root.view-y = root.view-y + dy * 1px;
    }

    public function end-pan() {
        root.pan-active = false;
    }

    changed selected-video-id => {
        root.view-centered = false;
        root.center-frame();
    }

    background: #121214;
    border-width: 1px;
    border-color: #27272a;
    clip: true;

    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 32px;
            background: #1a1a1e;
            Text { x: 10px; text: "Canvas workspace"; color: #818cf8; font-size: 11px; font-weight: 700; vertical-alignment: center; }
            Text { x: parent.width - 260px; width: 250px; text: "Middle drag or Space + drag to pan"; color: #858b96; font-size: 10px; vertical-alignment: center; horizontal-alignment: right; }
        }
        Rectangle { height: 1px; background: #27272a; }
        scope := FocusScope {
            vertical-stretch: 1;
            horizontal-stretch: 1;
            key-pressed(event) => {
                if (event.text == " ") {
                    root.space-held = true;
                    return EventResult.accept;
                }
                return EventResult.reject;
            }
            key-released(event) => {
                if (event.text == " ") {
                    root.space-held = false;
                    if (root.pan-active) {
                        root.end-pan();
                    }
                    return EventResult.accept;
                }
                return EventResult.reject;
            }
            scroll := ScrollView {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                mouse-drag-pan-enabled: false;
                viewport-x <=> root.view-x;
                viewport-y <=> root.view-y;
                viewport-width: root.world-w;
                viewport-height: root.world-h;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                Rectangle {
                    width: root.world-w;
                    height: root.world-h;
                    background: #101012;
                    for col in root.grid-cols: Rectangle {
                        x: root.grid-off-x - root.grid-step + col * root.grid-step;
                        width: 1px;
                        height: parent.height;
                        background: #1b1b1f;
                    }
                    for row in root.grid-rows: Rectangle {
                        y: root.grid-off-y - root.grid-step + row * root.grid-step;
                        width: parent.width;
                        height: 1px;
                        background: #1b1b1f;
                    }
                    // Background pan area: behind layers, middle + space+left only.
                    pan-area := TouchArea {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        mouse-cursor: root.space-held ? MouseCursor.grab : MouseCursor.default;
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                if (event.button == PointerEventButton.middle || (event.button == PointerEventButton.left && root.space-held)) {
                                    root.start-pan(self.mouse-x / 1px, self.mouse-y / 1px);
                                } else if (event.button == PointerEventButton.left) {
                                    scope.focus();
                                }
                            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                                if (root.pan-active) {
                                    root.end-pan();
                                }
                            }
                        }
                        scroll-event(event) => {
                            if (event.modifiers.control) {
                                if (event.delta-y > 0px) {
                                    root.request-zoom-in();
                                } else if (event.delta-y < 0px) {
                                    root.request-zoom-out();
                                }
                                return EventResult.accept;
                            }
                            return EventResult.reject;
                        }
                        changed pressed => {
                            if (!self.pressed && root.pan-active) {
                                root.end-pan();
                            }
                        }
                        moved => {
                            if (root.pan-active) {
                                root.apply-pan(self.mouse-x / 1px - root.pan-last-x, self.mouse-y / 1px - root.pan-last-y);
                                root.pan-last-x = self.mouse-x / 1px;
                                root.pan-last-y = self.mouse-y / 1px;
                            }
                        }
                    }
                    for layer in root.layers: CanvasLayerItem {
                        layer-id: layer.id;
                        layer-type: layer.layer-type;
                        layer-x: root.origin-x / 1px / root.zoom + layer.x;
                        layer-y: root.origin-y / 1px / root.zoom + layer.y;
                        layer-width: layer.width;
                        layer-height: layer.height;
                        layer-visible: layer.visible;
                        selected: layer.selected;
                        zoom: root.zoom;
                        space-held: root.space-held;
                        preview-image: layer.preview-image;
                        preview-available: layer.preview-available;
                        asset-name: layer.asset-name;
                        asset-valid: layer.asset-valid;
                        selected-layer => { root.select-layer(layer.id); }
                        drag-started(id) => { root.drag-start(id); }
                        dragged(dx, dy) => { root.drag-layer(layer.id, dx, dy); }
                        drag-ended(id) => { root.drag-finish(id); }
                        resize-started(id) => { root.resize-start(id); }
                        handle-dragged(handle, dx, dy) => { root.resize-layer(layer.id, handle, dx, dy); }
                        resize-ended(id) => { root.resize-finish(id); }
                        pan-started => { root.pan-active = true; scope.focus(); }
                        pan-moved(dx, dy) => { root.apply-pan(dx, dy); }
                        pan-ended => { root.end-pan(); }
                        wheel-zoom-in => { root.request-zoom-in(); }
                        wheel-zoom-out => { root.request-zoom-out(); }
                    }
                    Rectangle {
                        x: root.origin-x;
                        y: root.origin-y;
                        width: root.frame-w;
                        height: root.frame-h;
                        border-width: 2px;
                        border-color: #6366f1;
                        background: transparent;
                    }
                    Text {
                        x: root.origin-x;
                        y: root.origin-y - 22px;
                        text: "OUTPUT 9:16  " + root.output-width + "x" + root.output-height;
                        color: #818cf8;
                        font-size: 10px;
                    }
                }
                changed visible-width => {
                    if (!root.view-centered) {
                        root.center-frame();
                    }
                }
            }
        }
    }
}
